    # Required libraries (if not statically linked)
    # "lib/libps4splitscreen.sprx" = "install_ps4/lib/libps4splitscreen.sprx"
    
    # Param.sfo (generated by orbis-pub-gen from metadata above)
    # "sce_sys/param.sfo" = "auto"
    
