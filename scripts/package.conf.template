    "np_commerce" = "true"
    "np_commerce2" = "true"
    "np_drm" = "true"
    "np_social" = "true"
    "uac_network" = "true"
    "uac_network_host" = "true"
    "uac_network_client" = "true"
    "uac_internet" = "true"
